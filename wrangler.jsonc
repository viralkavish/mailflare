{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailflare",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"vars": {
		"APP_URL": "https://mail.vdesai.com",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGNatoaVdDqYB4Jd",
		"VAPID_PUBLIC_KEY": "BA-olRgXc0PoBfDWNe-3MmMtKAQe903j7Uc2Qye6vT6-MaWXjmrgrUJzw14REQpInHjR8NmdxhUxjCxszzfavSU",
		"VAPID_SUBJECT": "mailto:viral@vdesai.com",
		"CF_EMAIL_WORKER_NAME": "mailflare",
		"GITHUB_UPDATE_REPO": "viralkavish/mailflare",
		"AI_MODEL": "gemini-2.5-flash"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mailflare",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "DEVICE_LOGIN_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 },
		},
		{
			"name": "AGENT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"ai": { "binding": "AI", "remote": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailflare",
			"database_id": "56de285c-0775-43eb-a13c-fa1e7e59ce53",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mailflare-outbound",
			},
			{
				"binding": "AGENT_QUEUE",
				"queue": "mailflare-agent",
			},
		],
		"consumers": [
			{
				"queue": "mailflare-inbound",
				"max_batch_size": 5,
				// New mail should reach the inbox at once; do not wait up to 5 s for a batch to fill.
				"max_batch_timeout": 1,
				// Mail waits out a database that is behind the code (300 s per retry, about an hour); see docs/deployment.md.
				"max_retries": 12,
			},
			{
				"queue": "mailflare-outbound",
				"max_batch_size": 5,
				// Sends wait out the undo window already; do not also wait for a batch to fill.
				"max_batch_timeout": 1,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-agent",
				"max_batch_size": 1,
				"max_retries": 3,
			},
		],
	},
}
